#!/usr/bin/env sh

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

IFS='
'
set -f

sources="
.config
.local
.profile
.zshenv
"

for file in $(find $sources -type f); do
  echo "Linking $file"

  # Backup existing files
  if [ -e "$HOME/$file" ] && [ ! -L "$HOME/$file" ]; then
    backup="$file.backup.$(date +%s)"
    mv "$HOME/$file" "$HOME/$backup"
  fi

  # Create symlink
  mkdir -p "$(dirname "$HOME/$file")"
  ln -nfs "$dir/$file" "$HOME/$file"
done

unset IFS
set +f

# Remove links left dangling by a rename in the repo; nothing above deletes them.
"$dir/.local/bin/dot-prune"

# Set DOTFILES_DIR
echo "export DOTFILES_DIR=$dir" > "$ZDOTDIR/dotfiles-dir.zsh"

# Register the systemd user units symlinked above. Editing an existing unit
# still needs `systemctl --user daemon-reload`; this covers a fresh machine.
if command -v systemctl > /dev/null && [ -d /run/systemd/system ]; then
  systemctl --user daemon-reload
  systemctl --user enable quickshell.service wayland-pipewire-idle-inhibit.service
fi

# Generate the themed configs for the selected theme (catppuccin-macchiato by
# default). The selection lives in $XDG_STATE_HOME/theme, never in the repo.
"$dir/.local/bin/theme" apply --no-reload

if [ "$1" = "--deps" ]; then
  if [ $(uname) = "Darwin" ]; then
    echo "MacOS detected"
    if ! command -v brew &> /dev/null; then
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi
    brew bundle --no-lock
  fi

  if command -v apt &> /dev/null; then
    echo "Debian/Ubuntu detected"
    sudo apt update
    sudo apt install -y git bat eza fzf neovim ripgrep tmux zoxide direnv jq just
  fi
fi
