[Unit]
Description=Quickshell session lock
Documentation=https://quickshell.outfoxxed.me/
PartOf=graphical-session.target
After=graphical-session.target

# Deliberately no StartLimit: once the compositor is holding a session lock it
# keeps holding it whether or not a client is alive, so a shell that gives up
# restarting leaves a locked session with nothing to type into. Retrying for
# ever is the recoverable failure; giving up is not.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/quickshell -p %h/.config/quickshell/lock.qml

# on-failure, not always: a clean exit is a successful unlock and must stay
# gone, while a crash while locked has to come back and re-lock.
Restart=on-failure
RestartSec=1

Environment=QT_QPA_PLATFORM=wayland
Environment=QT_QPA_PLATFORMTHEME=kde

# No [Install] section: started on demand by `lock`, never part of the session
# target.
