export XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export SDL_VIDEODRIVER=wayland
export _JAVA_AWT_WM_NONREPARENTING=1
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24

# The nvidia modules are loaded on this machine, so sway pops a swaynag on
# every start ("Proprietary GPU drivers are not supported by sway"). Any value
# silences the dialog; the one-line [ERROR] in the journal is unconditional and
# stays. sway 1.12 no longer lists --unsupported-gpu in --help, so the variable
# is the only route -- and it has to be in sway's own environment, which is why
# it lives here (and in sway/profile for the laptop) rather than in
# environment.d, whose vars the sway-run path never sees.
export SWAY_UNSUPPORTED_GPU=true
