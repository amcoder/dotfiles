# Read `man 5 sway` for a complete reference.

# Load system sway config files
include /etc/sway/config.d/*

# Logo key. Use Mod1 for Alt.
set $mod Mod4

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Your preferred terminal emulator
set $term alacritty

# Your preferred browser
set $browser google-chrome --ozone-platform=wayland

# Output configuration
# No output is named here. sway-outputs derives each one's mode and scale from
# its EDID and writes them to the generated outputs.conf, which is what makes a
# restart and a `swaymsg reload` keep the resolution -- sway resets an output it
# has no config for to its preferred mode, which on this monitor is 3840x1080.
# sway-outputs.service keeps that file current and handles hotplug.
# `sway-outputs show` reports what it resolved; its two override tables are the
# place for anything it gets wrong.
include outputs.conf

# Colors
# Generated by `theme apply` from themes/ in the dotfiles repo.
include theme.conf

# Enable/disable the internal laptop panel based on lid position. No connector
# is named: sway-laptop-lid finds the internal panel from DRM and the lid state
# from logind, so this needs no edit on a different laptop and does nothing at
# all on a desktop. --reload re-runs the binding matching the current lid state
# on every reload, which is what keeps a shut lid shut across one.
bindswitch --reload --locked lid:on exec sway-laptop-lid closed
bindswitch --reload --locked lid:off exec sway-laptop-lid open
exec_always sway-laptop-lid

### Idle configuration
#
# swayidle is only an adapter for logind's signals now. Quickshell 0.3.0 has no
# logind client, so nothing in the shell can hear the Lock signal that
# `loginctl lock-session` raises -- which is what $mod+Escape, the session menu
# and kdeconnect all go through. Every timeout lives in
# quickshell/services/IdleService.qml instead, so there is no policy here.
exec_always "killall swayidle; swayidle -w \
        idlehint 120 \
        lock 'lock' \
        unlock 'systemctl --user stop quickshell-lock.service' \
        before-sleep 'lock'"

# Hide cursor after timeout, or when typing. Unclutter.
seat * hide_cursor 5000
seat * hide_cursor when-typing enable

# Set the cursor theme
seat * xcursor_theme Breeze_Light 24

### Input configuration
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}

input type:pointer {
    natural_scroll enabled
}

focus_follows_mouse no

input type:keyboard {
    xkb_numlock enabled
    xkb_options caps:ctrl_modifier,compose:ralt
}

# settings for x1 keyboard
input "1:1:AT_Translated_Set_2_keyboard" {
    xkb_options caps:ctrl_modifier,altwin:swap_lalt_lwin,compose:ralt
}

# Session services: quickshell, poweralertd, wayland-pipewire-idle-inhibit.
# Quoted so the whole chain reaches one shell -- the environment import must
# finish before the target starts.
exec "systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP && systemctl --user start sway-session.target"

# No `exec` block for apps: uwsm runs XDG autostart, so they come from
# .config/autostart and /etc/xdg/autostart with systemd owning the lifecycle.
# nm-applet is still started, by /etc/xdg/autostart/nm-applet.desktop, and is
# still wanted for NetworkManager's secret agent rather than for its tray icon,
# which the bar hides.

# Kill focused window
bindsym $mod+Shift+q kill

# Launcher, run prompt and window switcher (drawn by quickshell)
bindsym $mod+Space exec quickshell ipc call launcher toggle
bindsym $mod+Shift+Space exec quickshell ipc call launcher run
bindsym $mod+Alt+Space exec quickshell ipc call windows toggle

# Alt-tab-style cycling through windows in most-recently-used order, also drawn
# by quickshell. Tapping Super+Tab switches to the last window with nothing
# appearing on screen; holding Super brings up the picker.
#
# The mode is how the keyboard is handed over. It deliberately binds almost
# nothing, so every later Tab -- and the Super release that commits the choice,
# which sway itself cannot report -- reaches the picker's own layer surface
# instead of a binding here. The shell returns to the default mode when the
# gesture ends.
set $cycle Cycle
bindsym $mod+Tab mode $cycle, exec quickshell ipc call windows next
bindsym $mod+Shift+Tab mode $cycle, exec quickshell ipc call windows previous

# The MX Master's thumb button, which sends Ctrl+Alt+Tab -- established by
# binding every keycode on that device alone and pressing it, since it emits no
# mouse button at all and so does nothing by default. Scoped to the mouse by
# identifier, so the same combo from a keyboard is left to whatever wants it.
#
# There is no modifier to hold, so this opens the picker drawn and the next
# press commits, the way releasing Super does. It deliberately does *not* enter
# the cycle mode, unlike $mod+Tab: one binding that stays live in the default
# mode is what lets the second press reach it. Binding the combo in both modes
# instead fires both on a single press -- sway re-matches the press in the mode
# the first binding just switched to -- which opened the picker and immediately
# closed it again. Nothing is lost by staying in the default mode, since the
# picker holds the keyboard itself: Tab and Escape are unbound here and reach it.
set $thumb 1133:45081:Logitech_Wireless_Mouse_MX_Master_2S
bindsym --input-device=$thumb Ctrl+Alt+Tab exec quickshell ipc call windows cycle

mode $cycle {
    # The way out if the shell never takes the keyboard, which is the only way
    # this mode can be left holding it.
    bindsym Escape mode default, exec quickshell ipc call windows cancel
    bindsym $mod+Escape mode default, exec quickshell ipc call windows cancel
}

# Drag floating windows by holding down $mod and left mouse button.
# Resize them with right mouse button + $mod.
floating_modifier $mod normal

# Move your focus around
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
# Or use $mod+[up|down|left|right]
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move the focused window with the same, but add Shift
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
# Ditto, with arrow keys
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspace definitions
# Note: the span holds a Phosphor icon name rendered by quickshell (.config/quickshell/icons/)
# The value is double-quoted so the single quotes around the colour survive.
# sway names the workspace that exists at startup after the `workspace number`
# binding that mentions it, and that path strips one level of quoting -- without
# the outer quotes the first workspace comes up as
# `1: 1 <span foreground=#89b4fa>envelope</span>`, which no longer parses as a
# span, so the bar shows the icon's name as text until you leave and come back.
set  $ws1  "1: 1  <span foreground='$accent01'>envelope</span>"
set  $ws2  "2: 2  <span foreground='$accent02'>globe</span>"
set  $ws3  "3: 3  <span foreground='$accent03'>terminal-window</span>"
set  $ws4  "4: 4  <span foreground='$accent04'>code</span>"
set  $ws5  "5: 5  <span foreground='$accent05'>code</span>"
set  $ws6  "6: 6  <span foreground='$accent06'>code</span>"
set  $ws7  "7: 7  <span foreground='$accent07'>app-window</span>"
set  $ws8  "8: 8  <span foreground='$accent08'>currency-dollar</span>"
set  $ws9  "9: 9  <span foreground='$accent09'>video</span>"
set $ws10 "10: 10 <span foreground='$accent10'>music-note</span>"
set $ws11 "11: 11 <span foreground='$accent11'>app-window</span>"
set $ws12 "12: 12 <span foreground='$accent12'>app-window</span>"
set $ws13 "13: 13 <span foreground='$accent13'>app-window</span>"
set $ws14 "14: 14 <span foreground='$accent14'>app-window</span>"
set $ws15 "15: 15 <span foreground='$accent01'>app-window</span>"
set $ws16 "16: 16 <span foreground='$accent02'>app-window</span>"
set $ws17 "17: 17 <span foreground='$accent03'>app-window</span>"
set $ws18 "18: 18 <span foreground='$accent04'>app-window</span>"
set $ws19 "19: 19 <span foreground='$accent05'>app-window</span>"

# Switch to workspace
bindsym $mod+1      workspace number $ws1
bindsym $mod+2      workspace number $ws2
bindsym $mod+3      workspace number $ws3
bindsym $mod+4      workspace number $ws4
bindsym $mod+5      workspace number $ws5
bindsym $mod+6      workspace number $ws6
bindsym $mod+7      workspace number $ws7
bindsym $mod+8      workspace number $ws8
bindsym $mod+9      workspace number $ws9
bindsym $mod+0      workspace number $ws10
bindsym $mod+Ctrl+1 workspace number $ws11
bindsym $mod+Ctrl+2 workspace number $ws12
bindsym $mod+Ctrl+3 workspace number $ws13
bindsym $mod+Ctrl+4 workspace number $ws14
bindsym $mod+Ctrl+5 workspace number $ws15
bindsym $mod+Ctrl+6 workspace number $ws16
bindsym $mod+Ctrl+7 workspace number $ws17
bindsym $mod+Ctrl+8 workspace number $ws18
bindsym $mod+Ctrl+9 workspace number $ws19

bindsym $mod+Alt+Right  workspace next
bindsym $mod+Alt+$right workspace next
bindsym $mod+Alt+Left   workspace prev
bindsym $mod+Alt+$left  workspace prev


# Move focused container to workspace
bindsym $mod+Shift+1      move container to workspace number $ws1
bindsym $mod+Shift+2      move container to workspace number $ws2
bindsym $mod+Shift+3      move container to workspace number $ws3
bindsym $mod+Shift+4      move container to workspace number $ws4
bindsym $mod+Shift+5      move container to workspace number $ws5
bindsym $mod+Shift+6      move container to workspace number $ws6
bindsym $mod+Shift+7      move container to workspace number $ws7
bindsym $mod+Shift+8      move container to workspace number $ws8
bindsym $mod+Shift+9      move container to workspace number $ws9
bindsym $mod+Shift+0      move container to workspace number $ws10
bindsym $mod+Ctrl+Shift+1 move container to workspace number $ws11
bindsym $mod+Ctrl+Shift+2 move container to workspace number $ws12
bindsym $mod+Ctrl+Shift+3 move container to workspace number $ws13
bindsym $mod+Ctrl+Shift+4 move container to workspace number $ws14
bindsym $mod+Ctrl+Shift+5 move container to workspace number $ws15
bindsym $mod+Ctrl+Shift+6 move container to workspace number $ws16
bindsym $mod+Ctrl+Shift+7 move container to workspace number $ws17
bindsym $mod+Ctrl+Shift+8 move container to workspace number $ws18
bindsym $mod+Ctrl+Shift+9 move container to workspace number $ws19

# You can "split" the current object of your focus with
# $mod+b or $mod+v, for horizontal and vertical splits
# respectively.
bindsym $mod+b splith
bindsym $mod+v splitv

# Switch the current container between different layout styles
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Make the current focus fullscreen
bindsym $mod+f fullscreen

# Toggle the current focus between tiling and floating mode
bindsym $mod+Shift+f floating toggle

# Swap focus between the tiling area and the floating area
bindsym $mod+Ctrl+f focus mode_toggle

# Move focus to the parent container
bindsym $mod+a focus parent
# Move focus to the child container
bindsym $mod+z focus child

# Move the currently focused window to the scratchpad
bindsym $mod+Shift+minus move scratchpad

# Show the next scratchpad window or hide the focused scratchpad window.
# If there are multiple scratchpad windows, this command cycles through them.
bindsym $mod+minus scratchpad show

# Resize mode
set $resize --pango_markup ' Resize'
mode $resize {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 20px
    bindsym $down resize grow height 20px
    bindsym $up resize shrink height 20px
    bindsym $right resize grow width 20px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 20px
    bindsym Down resize grow height 20px
    bindsym Up resize shrink height 20px
    bindsym Right resize grow width 20px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode $resize

# Scale output
bindsym $mod+Ctrl+equal exec sway-scale up
bindsym $mod+Ctrl+minus exec sway-scale down
bindsym $mod+Ctrl+0 exec sway-scale default

# Swap the focused output between native and the best 16:9 mode
bindsym $mod+Ctrl+backslash exec sway-toggle-aspect

# Session Management
bindsym $mod+Escape exec loginctl lock-session

# Session menu (drawn by quickshell)
bindsym $mod+Shift+Escape exec quickshell ipc call power toggle

# Theme picker (drawn by quickshell)
bindsym $mod+Ctrl+t exec quickshell ipc call theme toggle

# Media Keys
bindsym XF86AudioRaiseVolume exec quickshell ipc call audio up
bindsym XF86AudioLowerVolume exec quickshell ipc call audio down
bindsym XF86AudioMute exec quickshell ipc call audio mute
bindsym XF86AudioMicMute exec quickshell ipc call audio micMute
bindsym XF86MonBrightnessDown exec quickshell ipc call brightness down
bindsym XF86MonBrightnessUp exec quickshell ipc call brightness up
bindsym XF86AudioPlay exec quickshell ipc call media playPause
bindsym XF86AudioNext exec quickshell ipc call media next
bindsym XF86AudioPrev exec quickshell ipc call media previous
bindsym XF86Search exec quickshell ipc call launcher toggle

# Gestures
bindgesture swipe:3:right workspace prev
bindgesture swipe:3:left workspace next

# Screenshots
bindsym $mod+p exec grimshot copy anything
bindsym $mod+Shift+p exec grimshot save anything

# App Shortcuts
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec $browser
bindsym $mod+backslash exec 1password --quick-access
bindsym $mod+Shift+backslash exec 1password
bindsym $mod+Shift+n exec nautilus
bindsym $mod+Shift+e exec quickshell ipc call emoji toggle

# Notifications (drawn by quickshell)
bindsym $mod+n exec quickshell ipc call notifications invoke
bindsym $mod+Ctrl+n exec quickshell ipc call notifications toggle
bindsym $mod+Alt+n exec quickshell ipc call notifications dnd

# Inhibit idle
for_window [con_mark="no idle"] inhibit_idle open; border normal 2
bindsym $mod+Shift+i [con_mark="no idle"] inhibit_idle none; [con_mark="no idle"] border pixel 2; \
                mark --toggle "no idle"; \
                [con_mark="no idle"] inhibit_idle open; [con_mark="no idle"] border normal 2

# Toggle title bar
bindsym $mod+Shift+t exec sway-toggle-title

# Window overrides
for_window {
    [shell="xwayland"] title_format "[XW] %title"

    [title=".*1Password$"] floating enable
    [title="^Copying.*Dolphin$"] floating enable

    [app_id="StorageExplorer" title="^Connect to Azure Storage$"] floating enable
    [app_id="StorageExplorer" title="^Edit Entity$"] floating enable
    [app_id="StorageExplorer" title="^Add Entity$"] floating enable

    [app_id="pavucontrol"] floating enable

    [app_id="org.gnome.Calculator"] floating enable
    [app_id="org.gnome.tweaks"] floating enable
    [app_id="org.gnome.baobab"] floating enable
    [app_id="org.gnome.FileRoller"] floating enable
    [app_id="org.gnome.NautilusPreviewer"] floating enable
    [app_id="gnome-disks"] floating enable
    [app_id="software-properties-gtk"] floating enable

    [app_id="blueman-manager"] floating enable

    [app_id="org.kde.kdeconnect-settings"] floating enable
    [app_id="org.kde.kdeconnect-indicator"] floating enable
    [app_id="org.kde.kdeconnect.handler"] floating enable
    [app_id="org.kde.kdeconnect.app"] floating enable

    [app_id="nm-connection-editor"] floating enable
    [app_id="nm-openconnect-auth-dialog"] floating enable

    [app_id="wdisplays"] floating enable

    [window_role="pop-up"] floating enable
    [window_role="bubble"] floating enable
    [window_role="dialog"] floating enable
    [window_type="dialog"] floating enable

    [title="^meeting bottombar popup$"] floating enable
    [title="^menu window$"] floating enable

    [title="(?:Open|Save) (?:File|Folder|As)"] floating enable
    [title="^Select path to save file$"] floating enable
}

# Visual config
font pango:FontAwesome, Cantarell 12
default_border pixel 2
default_floating_border pixel 2
smart_borders on
smart_gaps on
gaps inner 0
gaps outer 0
