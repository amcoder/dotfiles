#!/usr/bin/env zsh
#
# Pick a mode and a scale for every connected output, so the sway config does
# not have to name any of them.
#
# The mode is chosen by aspect ratio first, then pixel count, then refresh --
# not by pixel count alone. Sway's own default is the EDID preferred timing,
# which on the Odyssey G9 is 3840x1080; and that panel also advertises
# 3840x2160 (8.29MP), which beats its native 5120x1440 (7.37MP) on pixels. Only
# ranking the modes against the panel's *physical* aspect ratio picks the
# native one.
#
# The scale ladder is integer -- 2 at or above $dpiThreshold, 1 below -- since
# fractional scaling costs Xwayland sharpness and 1/2 is what this setup has
# always used. DPI alone ignores viewing distance, so a 48" desktop panel and a
# 14" laptop at the same DPI do not want the same scale; $scaleOverrides is the
# escape hatch.

set -u
# (#b) backreferences below are an extended-glob feature, and a script does not
# inherit the interactive shell's options.
setopt extended_glob

self=${ZSH_ARGZERO:t}

# Below this many DPI an output gets scale 1, at or above it scale 2.
dpiThreshold=165

# Per-output overrides, keyed by either the sway identifier ("make model
# serial", as `swaymsg -t get_outputs` reports it) or the connector name. The
# identifier is preferred: connector names are not stable -- this monitor moved
# from HDMI-A-1 to DP-2 and silently orphaned two lines of sway config.
typeset -A scaleOverrides
scaleOverrides=(
  # 'Samsung Electric Company Odyssey G93SC HCSX504312' 1
)

# Values are "WIDTHxHEIGHT" (highest refresh at that resolution) or
# "WIDTHxHEIGHT@REFRESH".
typeset -A modeOverrides
modeOverrides=(
  # eDP-1 '1920x1080@60Hz'
)

die() { print -ru2 -- "$self: $*"; exit 1 }

# Physical size of a connector's panel, in millimetres, from its EDID. Sway's
# IPC does not report it. Prefers the first detailed timing descriptor (whole
# millimetres) over the base block (rounded to whole centimetres).
edid_mm() {
    local name=$1 dir f
    local -a b
    # (-/) and not (/): the connector directories are symlinks.
    for dir in /sys/class/drm/card*-${name}(N-/); do
        # card*-DP-1 must not pick up card0-eDP-1.
        [[ ${dir:t} == card<->-${name} ]] || continue
        f=$dir/edid
        # -r, not -s: a sysfs binary attribute always stats as zero bytes.
        [[ -r $f ]] || continue
        b=( ${(f)"$(od -An -tu1 -v -N128 $f | tr -s ' ' '\n' | grep -v '^$')"} )
        (( $#b >= 128 )) || continue

        # Detailed timing descriptor 1 starts at EDID offset 54; bytes 12-14 of
        # it hold the horizontal and vertical image size, with the high nibbles
        # of both packed into the third. zsh arrays are 1-based.
        local hi=$b[69]
        local w=$(( b[67] | ((hi & 0xF0) << 4) ))
        local h=$(( b[68] | ((hi & 0x0F) << 8) ))
        (( w > 0 && h > 0 )) && { print -r -- "$w $h"; return 0 }

        # Base block, in centimetres.
        w=$(( b[22] * 10 )) h=$(( b[23] * 10 ))
        (( w > 0 && h > 0 )) && { print -r -- "$w $h"; return 0 }
    done
    return 1
}

# "WIDTHxHEIGHT" or "WIDTHxHEIGHT@REFRESH", into $match.
parse_mode() {
    [[ $1 == (#b)([0-9]##)x([0-9]##)(|@([0-9.]##)(|Hz)) ]]
}

# Up front and in the main shell: resolve() runs inside a command substitution,
# where a die() would exit only the subshell and be reported once per caller.
validate_overrides() {
    local key
    for key in ${(k)modeOverrides}; do
        parse_mode ${modeOverrides[$key]} \
            || die "$key: cannot parse mode override \"${modeOverrides[$key]}\""
    done
}

# The best mode for one output, as "WIDTH HEIGHT REFRESH_MHZ". $3 is the
# aspect ratio to rank against -- normally the panel's physical one, 0 when the
# EDID gave us nothing; $4 is an optional modeOverrides filter; $5 and $6 an
# optional bounding box no mode may exceed.
best_mode() {
    local outputs=$1 name=$2 aspect=$3 want=${4:-} maxW=${5:-0} maxH=${6:-0}
    local wantW=0 wantH=0 wantHz=0
    if [[ -n $want ]]; then
        parse_mode $want || return 1
        wantW=$match[1] wantH=$match[2] wantHz=${match[4]:-0}
    fi

    jq -r --arg name "$name" --argjson aspect "$aspect" \
          --argjson w "$wantW" --argjson h "$wantH" --argjson hz "$wantHz" \
          --argjson maxW "$maxW" --argjson maxH "$maxH" '
        [.[] | select(.name == $name)][0].modes
        | map(select(.width > 0 and .height > 0))
        | map(select($w == 0 or (.width == $w and .height == $h)))
        | map(select($hz == 0 or (((.refresh / 1000) - $hz) | fabs) < 1))
        | map(select($maxW == 0 or (.width <= $maxW and .height <= $maxH)))
        | map({
            w: .width, h: .height, r: .refresh,
            # Log ratio, so a 4:3-vs-3:4 error is symmetric.
            err: (if $aspect > 0 then (((.width / .height) / $aspect) | log | fabs) else 0 end)
          })
        # Bucket the aspect error at 5% before ranking, so every mode that
        # matches the panel shape competes on pixels and refresh rather than on
        # EDID rounding.
        | sort_by([(.err * 20 | floor), -(.w * .h), -.r])
        | .[0] // empty
        | "\(.w) \(.h) \(.r)"
    ' <<< "$outputs"
}

# Sway wants a mode string; its refresh is in Hz, the IPC reports mHz.
mode_str() {
    printf '%dx%d@%.3fHz' $1 $2 $(( $3 / 1000.0 ))
}

# Average the horizontal and vertical DPI rather than taking the diagonal: the
# two differ only when the mode is not the panel's own aspect ratio, and then
# neither reading is more honest than their mean.
mode_dpi() {
    local w=$1 h=$2 wmm=$3 hmm=$4
    (( wmm > 0 && hmm > 0 )) || { print -r -- 0; return 0 }
    print -r -- $(( (($w * 25.4) / $wmm + ($h * 25.4) / $hmm) / 2 ))
}

# Everything one connected output resolves to: "MODE SCALE DPI".
resolve() {
    local outputs=$1 name=$2 identifier=$3
    local wmm=0 hmm=0 aspect=0 mm

    if mm=$(edid_mm $name); then
        wmm=${mm%% *} hmm=${mm##* }
        aspect=$(( 1.0 * wmm / hmm ))
    fi

    local override=${modeOverrides[$identifier]:-${modeOverrides[$name]:-}}
    local best w h r
    best=$(best_mode "$outputs" "$name" "$aspect" "$override")
    if [[ -z $best ]]; then
        if [[ -n $override ]]; then
            print -ru2 -- "$self: $name: no mode matching override \"$override\""
        else
            print -ru2 -- "$self: $name: no usable mode"
        fi
        return 1
    fi
    read -r w h r <<< "$best"

    local dpi=$(mode_dpi $w $h $wmm $hmm)
    local scale=${scaleOverrides[$identifier]:-${scaleOverrides[$name]:-}}
    if [[ -z $scale ]]; then
        (( dpi >= dpiThreshold )) && scale=2 || scale=1
    fi

    print -r -- "$(mode_str $w $h $r) $scale $dpi"
}

apply_output() {
    local outputs=$1 name=$2 identifier=$3
    local resolved mode scale dpi
    resolved=$(resolve "$outputs" "$name" "$identifier") || return 1
    read -r mode scale dpi <<< "$resolved"

    local cw ch cr currentScale
    read -r cw ch cr currentScale <<< "$(jq -r --arg name "$name" '
        [.[] | select(.name == $name)][0]
        | "\(.current_mode.width) \(.current_mode.height) \(.current_mode.refresh) \(.scale)"
    ' <<< "$outputs")"

    # Only ever issue a change that is actually a change. Re-committing an
    # output is a full modeset, which is the path that wedges this GPU (see
    # .claude/sway-lockup-investigation.md).
    local -a cmd
    [[ "$(mode_str $cw $ch $cr)" != $mode ]] && cmd+=(mode $mode)
    (( currentScale != scale )) && cmd+=(scale $scale)

    if (( $#cmd == 0 )); then
        print -r -- "$name: $mode scale $scale (unchanged)"
        return 0
    fi

    print -r -- "$name: $cmd"
    swaymsg -- output "$name" $cmd > /dev/null
}

get_outputs() {
    swaymsg -r -t get_outputs || die "cannot reach sway"
}

# "make model serial" is what sway matches an `output` directive against, and
# unlike the connector name it is stable across reboots and ports.
identifier_of() {
    jq -r --arg name "$1" '
        [.[] | select(.name == $name)][0]
        | [.make, .model, .serial] | map(select(. != null and . != "")) | join(" ")
    ' <<< "$2"
}

active_names() {
    jq -r '.[] | select(.active) | .name' <<< "$1"
}

cmd_apply() {
    local outputs name
    outputs=$(get_outputs) || exit 1
    for name in ${(f)"$(active_names $outputs)"}; do
        apply_output "$outputs" "$name" "$(identifier_of $name $outputs)"
    done
}

# One field of what an output resolves to, for the scripts that need to agree
# with the ladder rather than carry their own copy of it. Defaults to the
# focused output.
resolve_field() {
    local field=$1 name=${2:-} outputs resolved
    outputs=$(get_outputs) || exit 1
    [[ -n $name ]] || name=$(jq -r '.[] | select(.focused) | .name' <<< "$outputs")
    resolved=$(resolve "$outputs" "$name" "$(identifier_of $name $outputs)") || return 1
    print -r -- ${${(z)resolved}[$field]}
}

# The native mode, or -- given "W:H" -- the best mode at that aspect ratio that
# still fits inside the native one. The bound is what makes the answer useful:
# this panel's largest 16:9 mode by pixel count is 3840x2160, which it cannot
# actually display (1440 rows of hardware) and must downscale, while 2560x1440
# lands on the native pixel grid exactly.
cmd_mode() {
    local name=${1:-} want=${2:-} outputs resolved native nw nh
    outputs=$(get_outputs) || exit 1
    [[ -n $name ]] || name=$(jq -r '.[] | select(.focused) | .name' <<< "$outputs")
    resolved=$(resolve "$outputs" "$name" "$(identifier_of $name $outputs)") || return 1
    native=${${(z)resolved}[1]}

    if [[ -z $want ]]; then
        print -r -- $native
        return 0
    fi

    [[ $want == (#b)([0-9]##):([0-9]##) ]] || die "cannot parse aspect ratio \"$want\""
    local aspect=$(( 1.0 * match[1] / match[2] ))

    nw=${native%%x*} nh=${${native#*x}%%@*}
    local best w h r
    best=$(best_mode "$outputs" "$name" "$aspect" "" $nw $nh)
    [[ -n $best ]] || { print -ru2 -- "$self: $name: no $want mode within ${nw}x${nh}"; return 1 }
    read -r w h r <<< "$best"
    print -r -- "$(mode_str $w $h $r)"
}

cmd_show() {
    local outputs name identifier mm resolved mode scale dpi
    outputs=$(get_outputs) || exit 1
    for name in ${(f)"$(active_names $outputs)"}; do
        identifier=$(identifier_of $name $outputs)
        mm=$(edid_mm $name) || mm="0 0"
        resolved=$(resolve "$outputs" "$name" "$identifier") || continue
        read -r mode scale dpi <<< "$resolved"
        printf '%-8s %-50s %5smm x %4smm  %-20s %3.0f dpi  scale %s\n' \
            "$name" "$identifier" "${mm%% *}" "${mm##* }" "$mode" "$dpi" "$scale"
    done
}

# Configure an output once, when it appears -- not on every event. A mode or a
# scale set by hand afterwards (sway-scale, sway-toggle-aspect) fires an output
# event of its own, and re-applying on that would undo it a frame later.
cmd_watch() {
    local -A seen
    local outputs name identifier

    handle() {
        outputs=$(get_outputs) || return 0
        local -A present
        for name in ${(f)"$(active_names $outputs)"}; do
            identifier=$(identifier_of $name $outputs)
            [[ -n $identifier ]] || identifier=$name
            present[$identifier]=1
            (( ${+seen[$identifier]} )) && continue
            seen[$identifier]=1
            apply_output "$outputs" "$name" "$identifier"
        done
        # Forget what went away, so replugging it configures it again.
        for identifier in ${(k)seen}; do
            (( ${+present[$identifier]} )) || unset "seen[$identifier]"
        done
    }

    handle
    swaymsg -r -m -t subscribe '["output"]' | while IFS= read -r _; do
        # A hotplug arrives as a burst of events; act once, at the end of it.
        while read -r -t 0.3 _; do :; done
        handle
    done
}

validate_overrides

case ${1:-apply} in
    apply) cmd_apply ;;
    watch) cmd_watch ;;
    show)  cmd_show ;;
    mode)  cmd_mode ${2:-} ${3:-} ;;
    scale) resolve_field 2 ${2:-} ;;
    *) die "usage: $self {apply|watch|show|mode [output] [W:H]|scale [output]}" ;;
esac
