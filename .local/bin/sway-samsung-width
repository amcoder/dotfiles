#!/usr/bin/env zsh
#
# Halve or restore the focused output's width, for running the ultrawide as a
# single 16:9 panel. The connector is not named here -- it moved from HDMI-A-1
# to DP-2 once already, which silently broke this script.

swaymsg -t get_outputs | jq -r '.[] | select(.focused) | [.name, .current_mode.width] | @tsv' \
    | read -r output width

# The native mode, as sway-outputs resolves it from the EDID.
native=$(sway-outputs mode "$output") || exit 1
nativeWidth=${native%%x*}
rest=${native#*x}

if (( width == nativeWidth )); then
    swaymsg output "$output" mode $(( nativeWidth / 2 ))x$rest
else
    swaymsg output "$output" mode "$native"
fi
