#!/usr/bin/env zsh

swaymsg -t get_outputs | jq -r '.[] | select(.focused) | [.name, .scale] | @tsv' | read -r output scale

case $1 in
    up)
        let "scale = $scale + 0.1"
        ;;
    down)
        let "scale = $scale - 0.1"
        ;;
    default)
        # The ladder lives in sway-outputs, so this and the login-time scale
        # cannot disagree.
        scale=$(sway-outputs scale "$output")
        ;;
    *)
        echo "Usage: $(basename $0) {up|down|default}"
        exit 1
        ;;
esac

scale=$(printf "%.1f" $scale)

swaymsg output "$output" scale "$scale"
