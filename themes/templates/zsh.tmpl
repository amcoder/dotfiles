# Generated by `theme` from themes/{{name}}.json -- edits will be overwritten.

THEME_NAME="{{name}}"

# fzf -- consumed by integration.zsh
THEME_FZF_COLORS=" \
  --color=bg+:{{surface0}},bg:{{base}},spinner:{{rosewater}},hl:{{red}} \
  --color=fg:{{text}},header:{{red}},info:{{mauve}},pointer:{{rosewater}} \
  --color=marker:{{rosewater}},fg+:{{text}},prompt:{{mauve}},hl+:{{red}}"

# powerlevel10k -- consumed by p10k.zsh
THEME_P10K_EDGE="{{base}}"

export BAT_THEME="{{batTheme}}"
