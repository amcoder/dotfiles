# Generated by `theme` from themes/{{name}}.json -- edits will be overwritten.

set $rosewater {{rosewater}}
set $flamingo {{flamingo}}
set $pink {{pink}}
set $mauve {{mauve}}
set $red {{red}}
set $maroon {{maroon}}
set $peach {{peach}}
set $yellow {{yellow}}
set $green {{green}}
set $teal {{teal}}
set $sky {{sky}}
set $sapphire {{sapphire}}
set $blue {{blue}}
set $lavender {{lavender}}
set $text {{text}}
set $subtext1 {{subtext1}}
set $subtext0 {{subtext0}}
set $overlay2 {{overlay2}}
set $overlay1 {{overlay1}}
set $overlay0 {{overlay0}}
set $surface2 {{surface2}}
set $surface1 {{surface1}}
set $surface0 {{surface0}}
set $base {{base}}
set $mantle {{mantle}}
set $crust {{crust}}

set $background     $crust
set $accent         $blue

set $accent01       {{accent01}}
set $accent02       {{accent02}}
set $accent03       {{accent03}}
set $accent04       {{accent04}}
set $accent05       {{accent05}}
set $accent06       {{accent06}}
set $accent07       {{accent07}}
set $accent08       {{accent08}}
set $accent09       {{accent09}}
set $accent10       {{accent10}}
set $accent11       {{accent11}}
set $accent12       {{accent12}}
set $accent13       {{accent13}}
set $accent14       {{accent14}}

# target                 title     bg      text       indicator  border
client.focused           $blue     $mantle $text      $rosewater $blue
client.focused_inactive  $overlay0 $base   $text      $rosewater $overlay0
client.unfocused         $overlay0 $base   $overlay0  $rosewater $overlay0
client.urgent            $red      $base   $red       $overlay0  $peach
client.placeholder       $overlay0 $base   $text      $overlay0  $overlay0
client.background        $base

# Wallpaper -- quickshell draws the image on the bottom layer, above this. The
# solid colour overrides the Debian default in /etc/sway/config.d/ and is what
# shows while the shell restarts.
output * bg $background solid_color
