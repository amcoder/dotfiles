# Generated by `theme` from themes/{{name}}.json -- edits will be overwritten.

[global]
    frame_color = "{{crust}}"

[urgency_low]
    background = "{{base}}"
    foreground = "{{text}}"
    frame_color = "{{surface0}}"
    highlight = "{{blue}}"

[urgency_normal]
    background = "{{base}}"
    foreground = "{{text}}"
    frame_color = "{{surface0}}"
    highlight = "{{blue}}"

[urgency_critical]
    background = "{{base}}"
    foreground = "{{text}}"
    frame_color = "{{red}}"
    highlight = "{{blue}}"
